.order-loading-card { height: 190rpx; margin-bottom: 17rpx; padding: 32rpx; border-radius: 23rpx; background: #fff; }
.order-empty { margin-top: 25rpx; }
.order-card { background: #fff; border-radius: 24rpx; padding: 23rpx; margin-bottom: 18rpx; box-shadow: 0 8rpx 30rpx rgba(45,35,27,.04); animation: fadeUp .28s ease both; }
