page { background: #f6f5f3; color: #262626; font-size: 28rpx; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
view, text, input, textarea, button, image, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0 24rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 64rpx; background: #fff; color: #3d3d3d; }
button::after { border: 1rpx solid #e8e4df; border-radius: 16rpx; }
button[disabled] { opacity: .5; }
button:active, .primary:active, .empty-primary:active, .action-button:active, .checkout-button:active, .pay-button:active, .cart-dock-action:active { transform: scale(.98); opacity: .92; }
.order-load-error { position: fixed; z-index: 30; left: 22rpx; right: 22rpx; top: 150rpx; }
.order-card { transition: transform .15s ease, box-shadow .15s ease; }
.order-card:active { transform: scale(.99); }
.order-detail-entry { display: flex; align-items: center; justify-content: flex-end; margin-top: 15rpx; padding-top: 14rpx; border-top: 1rpx solid #f0ece8; color: #a66d26; font-size: 21rpx; font-weight: 700; }
.order-detail-entry text { margin-left: 8rpx; font-size: 30rpx; font-weight: 400; line-height: 1; }
.admin-hero.paused { background: linear-gradient(135deg, #6e6963, #45413d); box-shadow: 0 16rpx 34rpx rgba(49,44,40,.19); }
.admin-live.paused { color: #e5e0db; background: rgba(0,0,0,.17); }.admin-live.paused > view { background: #efbc64; box-shadow: 0 0 0 6rpx rgba(239,188,100,.13); }
.business-control { display: flex; align-items: center; min-height: 116rpx; margin: 18rpx 0 25rpx; padding: 17rpx; border: 1rpx solid #e2eee5; border-radius: 23rpx; background: linear-gradient(145deg, #fbfffc, #f2fbf5); box-shadow: 0 9rpx 23rpx rgba(47,91,63,.035); }.business-control.paused { border-color: #e7dfd7; background: linear-gradient(145deg, #fffefd, #f7f2ed); }
.business-control-icon { width: 62rpx; height: 62rpx; flex: 0 0 62rpx; border-radius: 19rpx; color: #fff; background: #44a87f; font-size: 29rpx; font-weight: 800; line-height: 62rpx; text-align: center; }.business-control.paused .business-control-icon { color: #735e4d; background: #f1d7a1; }
.business-control-copy { flex: 1; min-width: 0; margin: 0 13rpx; }.business-control-copy text { display: block; }.business-control-copy text:first-child { color: #3c4c42; font-size: 24rpx; font-weight: 800; }.business-control.paused .business-control-copy text:first-child { color: #5a5149; }.business-control-copy text:last-child { overflow: hidden; margin-top: 5rpx; color: #8d9b91; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.business-control.paused .business-control-copy text:last-child { color: #9b9085; }
.business-toggle { flex: 0 0 auto; min-width: 130rpx; height: 64rpx; margin: 0; padding: 0 14rpx; border: 0; border-radius: 18rpx; color: #fff; font-size: 21rpx; font-weight: 800; line-height: 64rpx; }.business-toggle::after { border: 0; }.business-toggle.pause { background: #6a655f; }.business-toggle.resume { background: linear-gradient(135deg, #f36b39, #e84c29); box-shadow: 0 7rpx 15rpx rgba(219,75,40,.18); }
.store-open-dot.closed { background: #f3c366; box-shadow: 0 0 0 6rpx rgba(243,195,102,.16); }.store-closed-notice { display: flex; align-items: flex-start; margin: 14rpx 2rpx 18rpx; padding: 18rpx 20rpx; border: 1rpx solid #f2ddb2; border-radius: 18rpx; color: #81633b; background: #fff8e7; font-size: 22rpx; line-height: 1.5; }.store-closed-notice > text { flex: 0 0 auto; margin-right: 12rpx; padding: 3rpx 9rpx; border-radius: 9rpx; color: #8b681f; background: #ffedbf; font-size: 18rpx; font-weight: 800; }.store-paused-menu { opacity: .72; }.store-paused-menu .dish-card { filter: grayscale(.15); }.store-paused-menu .add-button.disabled { width: 76rpx; flex-basis: 76rpx; border-radius: 999rpx; background: #b9b5b0; font-size: 18rpx; }
.checkout-store-closed { display: flex; align-items: flex-start; margin-bottom: 18rpx; padding: 17rpx 19rpx; border: 1rpx solid #f1dab1; border-radius: 18rpx; color: #81633b; background: #fff8e8; font-size: 22rpx; line-height: 1.5; }.checkout-store-closed > text { flex: 0 0 auto; margin-right: 12rpx; padding: 4rpx 9rpx; border-radius: 9rpx; color: #89671d; background: #ffedbf; font-size: 18rpx; font-weight: 800; }
.admin-actions .reject-action { flex: 1; min-width: 126rpx; color: #c95043; background: #fff0ed; border: 1rpx solid #f4cbc4; }.admin-actions .reject-action::after { border: 0; }
.merchant-reject-alert { display: flex; align-items: flex-start; margin: 16rpx 0 3rpx; padding: 15rpx; border-radius: 16rpx; color: #9a5145; background: #fff1ed; font-size: 20rpx; line-height: 1.5; }.merchant-reject-alert > view:first-child { width: 32rpx; height: 32rpx; flex: 0 0 32rpx; margin-right: 10rpx; border-radius: 50%; color: #fff; background: #db705d; font-size: 21rpx; font-weight: 800; line-height: 32rpx; text-align: center; }.merchant-reject-alert > view:last-child text { display: block; }.merchant-reject-alert > view:last-child text:first-child { color: #784238; font-weight: 800; }.merchant-reject-alert > view:last-child text:last-child { margin-top: 3rpx; color: #a67e76; }
.page { min-height: 100vh; padding: 22rpx; padding-bottom: 150rpx; }
.primary { background: linear-gradient(135deg, #ff773e, #f05228) !important; color: #fff !important; border: 0; box-shadow: 0 10rpx 24rpx rgba(240, 82, 40, .2); }
.primary::after { border: 0; }
.primary.small, button.small { line-height: 56rpx; padding: 0 20rpx; font-size: 24rpx; }
.loading, .empty { text-align: center; color: #9a9691; padding: 90rpx 20rpx; }
.muted { color: #96918c; font-size: 23rpx; }
.notice { margin: 18rpx 0; padding: 20rpx 24rpx; background: #fff8e8; color: #8b640c; border-radius: 16rpx; font-size: 24rpx; line-height: 1.6; }
.notice.error { display: flex; align-items: center; gap: 12rpx; background: #fff0ec; color: #b9432d; }
.notice.error > text:first-child { width: 34rpx; height: 34rpx; border-radius: 50%; background: #ef6847; color: #fff; text-align: center; line-height: 34rpx; font-weight: 700; }
.danger, .danger-link, .danger-text { color: #d84a3a !important; }
.placeholder { display: flex; align-items: center; justify-content: center; background: linear-gradient(145deg, #fff2e8, #f8dfcd); }
.price { color: #ed5528; font-weight: 800; }
.price-symbol { font-size: 21rpx !important; margin-right: 2rpx; }
.price-unit { color: #a59e97; font-size: 20rpx !important; font-weight: 400; margin-left: 5rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; font-size: 34rpx; font-weight: 700; margin: 8rpx 0 24rpx; }
.card { background: #fff; border: 1rpx solid rgba(59, 45, 35, .04); border-radius: 24rpx; margin-bottom: 20rpx; padding: 26rpx; box-shadow: 0 8rpx 30rpx rgba(50, 38, 28, .035); }
.card-title { font-size: 30rpx; font-weight: 700; margin-bottom: 22rpx; }
.tabs { display: flex; background: #fff; border-radius: 18rpx; padding: 6rpx; margin-bottom: 22rpx; box-shadow: 0 6rpx 20rpx rgba(40, 32, 24, .035); }
.tab { position: relative; flex: 1; padding: 18rpx 8rpx; text-align: center; color: #8a8681; border-radius: 14rpx; transition: all .2s ease; }
.tab.active { background: #fff0e9; color: #ee552a; font-weight: 700; }
.empty-card { margin-top: 70rpx; background: #fff; border-radius: 26rpx; padding: 76rpx 30rpx; text-align: center; color: #88837e; box-shadow: 0 12rpx 36rpx rgba(45, 34, 24, .04); }
.empty-title { color: #312f2d; font-size: 31rpx; font-weight: 700; margin-top: 26rpx; }
.empty-desc { color: #9b9690; font-size: 24rpx; margin-top: 12rpx; line-height: 1.6; }
.empty-illustration { position: relative; width: 150rpx; height: 130rpx; margin: 0 auto; display: flex; align-items: center; justify-content: center; }
.empty-illustration text { position: relative; z-index: 2; font-size: 76rpx; }
.empty-illustration view { position: absolute; left: 10rpx; right: 10rpx; bottom: 4rpx; height: 26rpx; border-radius: 50%; background: rgba(236, 102, 53, .1); }
.shimmer { position: relative; overflow: hidden; background: #f0eeeb !important; }
.shimmer::after { content: ''; position: absolute; inset: 0; transform: translateX(-100%); background: linear-gradient(90deg, transparent, rgba(255,255,255,.72), transparent); animation: shimmer 1.35s infinite; }
.skeleton-line { width: 65%; height: 20rpx; border-radius: 10rpx; margin-bottom: 18rpx; }
.skeleton-line.wide { width: 86%; height: 25rpx; }
.skeleton-line.short { width: 42%; }
@keyframes shimmer { 100% { transform: translateX(100%); } }
@keyframes fadeUp { from { opacity: 0; transform: translateY(14rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes cartPulse { 0%,100% { transform: scale(1); } 45% { transform: scale(1.035); } }
@keyframes dishAdd { 0% { transform: scale(1); } 45% { transform: scale(.985); background: #fff8f4; } 100% { transform: scale(1); } }
@keyframes spin { to { transform: rotate(360deg); } }

/* 点餐首页 */
.menu-page { padding: 18rpx 18rpx 164rpx; background: #f7f5f2; }
.store-card { position: relative; overflow: hidden; padding: 24rpx 26rpx 20rpx; border-radius: 28rpx; background: linear-gradient(145deg, #ff7440, #f14f27 72%); color: #fff; box-shadow: 0 18rpx 38rpx rgba(225, 72, 31, .22); }
.store-card::before { content: ''; position: absolute; width: 230rpx; height: 230rpx; right: -75rpx; top: -90rpx; border-radius: 50%; background: rgba(255,255,255,.1); }
.store-card::after { content: ''; position: absolute; width: 120rpx; height: 120rpx; right: 115rpx; top: 66rpx; border-radius: 50%; border: 2rpx solid rgba(255,255,255,.1); }
.store-topline { position: relative; z-index: 1; display: flex; align-items: center; font-size: 21rpx; opacity: .9; }
.store-open-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #9df08b; margin-right: 10rpx; box-shadow: 0 0 0 6rpx rgba(157,240,139,.14); }
.store-content { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; margin-top: 19rpx; }
.store-name { font-size: 38rpx; font-weight: 800; letter-spacing: 1rpx; }
.store-sub { font-size: 22rpx; opacity: .83; margin-top: 7rpx; }
.store-mark { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; border-radius: 24rpx; background: rgba(255,255,255,.18); border: 1rpx solid rgba(255,255,255,.26); font-size: 36rpx; font-weight: 800; transform: rotate(4deg); }
.scene-entry { position: relative; z-index: 1; display: flex; align-items: center; margin-top: 22rpx; padding: 17rpx 18rpx; border-radius: 18rpx; background: rgba(112, 28, 8, .16); border: 1rpx solid rgba(255,255,255,.14); }
.scene-entry:active { background: rgba(112, 28, 8, .25); }
.scene-entry-icon { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: rgba(255,255,255,.17); font-size: 28rpx; }
.scene-entry-main { flex: 1; min-width: 0; margin-left: 15rpx; }
.scene-entry-main text { display: block; }
.scene-entry-main text:first-child { font-size: 27rpx; font-weight: 700; }
.scene-entry-main text:last-child { font-size: 20rpx; margin-top: 3rpx; opacity: .78; }
.scene-entry-arrow { font-size: 42rpx; opacity: .8; }
.search-box { display: flex; align-items: center; height: 78rpx; margin: 20rpx 0 16rpx; padding: 0 21rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 7rpx 24rpx rgba(48, 39, 31, .04); }
.search-icon { color: #6d6964; font-size: 34rpx; line-height: 1; }
.search-box input { flex: 1; height: 100%; margin-left: 12rpx; font-size: 25rpx; }
.search-clear { width: 38rpx; height: 38rpx; text-align: center; line-height: 36rpx; border-radius: 50%; background: #efedea; color: #9b9691; }
.menu-layout, .menu-skeleton { display: flex; height: calc(100vh - 430rpx); min-height: 690rpx; overflow: hidden; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 34rpx rgba(49, 39, 30, .04); }
.category-list, .skeleton-category { width: 146rpx !important; min-width: 146rpx; flex: 0 0 146rpx; height: 100%; background: #f3f1ee; }
.category-item { position: relative; width: 146rpx; min-height: 96rpx; padding: 24rpx 15rpx; display: flex; align-items: center; justify-content: center; text-align: center; color: #746f69; font-size: 24rpx; line-height: 1.35; transition: all .18s ease; }
.category-item text { width: 100%; white-space: normal; word-break: keep-all; }
.category-item.active { background: #fff; color: #e85229; font-weight: 700; }
.category-item.active::before { content: ''; position: absolute; left: 0; top: 26rpx; bottom: 26rpx; width: 7rpx; border-radius: 0 8rpx 8rpx 0; background: linear-gradient(#ff7a43, #ed4c25); }
.category-item.active::after { content: ''; position: absolute; right: 11rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #f05b31; }
.dish-list, .skeleton-list { flex: 1; min-width: 0; height: 100%; padding: 0 20rpx; }
.menu-section-title { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 21rpx 0 15rpx; background: rgba(255,255,255,.96); }
.menu-section-title > view:first-child text { display: block; }
.menu-section-title > view:first-child text:first-child { font-size: 29rpx; font-weight: 800; }
.menu-section-title > view:first-child text:last-child { color: #aaa49e; font-size: 19rpx; margin-top: 2rpx; }
.fresh-badge { padding: 7rpx 12rpx; border-radius: 999rpx; background: #eff8eb; color: #54894a; font-size: 18rpx; }
.dish-card { display: flex; width: 100%; padding: 20rpx 0; border-bottom: 1rpx solid #f0eeeb; animation: fadeUp .28s ease both; }
.dish-card.adding { animation: dishAdd .4s ease; }
.dish-media { position: relative; width: 142rpx; height: 142rpx; flex: 0 0 142rpx; }
.dish-image { width: 142rpx; height: 142rpx; border-radius: 20rpx; font-size: 53rpx; }
.dish-image.placeholder text { filter: drop-shadow(0 5rpx 5rpx rgba(80,45,22,.12)); }
.soldout-mask { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: rgba(39,36,33,.62); color: #fff; font-size: 23rpx; }
.dish-main { flex: 1; min-width: 0; margin-left: 17rpx; }
.dish-name { color: #292725; font-size: 29rpx; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dish-desc { color: #8f8a84; font-size: 20rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 7rpx; }
.dish-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 7rpx; min-height: 30rpx; margin-top: 8rpx; }
.dish-tags text { padding: 4rpx 8rpx; border-radius: 7rpx; background: #f6f3ef; color: #9a8f85; font-size: 17rpx; }
.dish-tags text:last-child { color: #df643f; background: #fff0ea; }
.dish-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 13rpx; }
.dish-bottom .price > text:nth-child(2) { font-size: 35rpx; }
.add-button { width: 54rpx; height: 54rpx; flex: 0 0 54rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(135deg, #ff7540, #ee4f28); color: #fff; box-shadow: 0 7rpx 16rpx rgba(238,79,40,.25); font-size: 36rpx; font-weight: 400; transition: transform .12s ease; }
.add-button:active { transform: scale(.86); }
.add-button.disabled { width: 76rpx; flex-basis: 76rpx; border-radius: 999rpx; background: #d7d3cf; box-shadow: none; font-size: 19rpx; }
.menu-empty > text { display: block; font-size: 58rpx; margin-bottom: 16rpx; }
.menu-empty > view:nth-child(2) { color: #4d4945; font-weight: 700; }
.menu-empty > view:last-child { font-size: 21rpx; margin-top: 6rpx; }
.skeleton-list { padding-top: 20rpx; }
.skeleton-card { display: flex; margin-bottom: 24rpx; }
.skeleton-image { width: 142rpx; height: 142rpx; flex: 0 0 142rpx; border-radius: 20rpx; }
.skeleton-lines { flex: 1; padding: 12rpx 0 0 18rpx; }
.cart-dock { position: fixed; z-index: 10; left: 30rpx; right: 30rpx; bottom: 118rpx; height: 96rpx; display: flex; align-items: center; padding: 10rpx 13rpx; border-radius: 26rpx; background: rgba(38, 34, 31, .96); color: #fff; box-shadow: 0 16rpx 38rpx rgba(28,24,21,.27); backdrop-filter: blur(10px); }
.cart-dock.pulse { animation: cartPulse .42s ease; }
.cart-dock-icon { position: relative; width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: linear-gradient(135deg, #ff7841, #ed4d27); font-size: 35rpx; }
.cart-dock-icon text { position: absolute; right: -5rpx; top: -8rpx; min-width: 31rpx; height: 31rpx; padding: 0 6rpx; border-radius: 16rpx; background: #fff; color: #ed512b; border: 3rpx solid #332e2b; text-align: center; line-height: 27rpx; font-size: 18rpx; font-weight: 800; }
.cart-dock-main { flex: 1; min-width: 0; margin-left: 15rpx; }
.cart-dock-main text { display: block; }
.cart-dock-main text:first-child { font-size: 26rpx; font-weight: 700; }
.cart-dock-main text:last-child { color: #bdb7b2; font-size: 18rpx; margin-top: 2rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cart-dock-action { height: 62rpx; display: flex; align-items: center; padding: 0 17rpx; border-radius: 19rpx; background: #fff; color: #2f2b28; font-size: 23rpx; font-weight: 700; }
.cart-dock-action text { font-size: 31rpx; margin-left: 5rpx; }
.sheet-mask { position: fixed; inset: 0; z-index: 30; background: rgba(24,20,17,.52); animation: fadeUp .2s ease; }
.scene-sheet { position: fixed; z-index: 31; left: 0; right: 0; bottom: 0; padding: 14rpx 25rpx 0; border-radius: 32rpx 32rpx 0 0; background: #fff; transform: translateY(105%); transition: transform .28s cubic-bezier(.2,.8,.2,1); }
.scene-sheet.visible { transform: translateY(0); }
.sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 24rpx; border-radius: 4rpx; background: #dedad6; }
.sheet-title { font-size: 35rpx; font-weight: 800; }
.sheet-subtitle { color: #98928c; font-size: 22rpx; margin-top: 6rpx; margin-bottom: 22rpx; }
.scene-option { display: flex; align-items: center; min-height: 104rpx; padding: 16rpx; margin-bottom: 13rpx; border-radius: 20rpx; border: 2rpx solid #efedea; transition: all .15s ease; }
.scene-option.active { border-color: #f2663a; background: #fff7f3; }
.scene-option-icon { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; background: #f6f3ef; font-size: 33rpx; }
.scene-option-info { flex: 1; margin-left: 17rpx; }
.scene-option-info text { display: block; }
.scene-option-info text:first-child { color: #2e2b28; font-size: 28rpx; font-weight: 700; }
.scene-option-info text:last-child { color: #9b958f; font-size: 21rpx; margin-top: 3rpx; }
.scene-check { width: 42rpx; height: 42rpx; border-radius: 50%; background: #f05b31; color: #fff; text-align: center; line-height: 42rpx; font-weight: 700; }
.scene-option:not(.active) .scene-check { border: 2rpx solid #dedad6; background: #fff; }
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }

/* 菜品详情 */
.detail-page { padding: 0 0 170rpx; background: #f6f4f1; }
.detail-hero { position: relative; height: 500rpx; overflow: hidden; background: #f4e2d6; }
.hero-image { width: 100%; height: 100%; font-size: 116rpx; }
.hero-gradient { position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, rgba(25,19,15,.36)); }
.hero-badge { position: absolute; left: 26rpx; bottom: 24rpx; padding: 10rpx 18rpx; border-radius: 999rpx; background: rgba(255,255,255,.9); color: #5c4b3f; font-size: 21rpx; backdrop-filter: blur(8px); }
.detail-card, .spec-card { background: #fff; margin: 18rpx 20rpx; padding: 27rpx; border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(46,36,28,.035); }
.detail-card { position: relative; margin-top: -20rpx; z-index: 2; }
.detail-title-row { display: flex; justify-content: space-between; align-items: center; }
.detail-title { font-size: 38rpx; font-weight: 800; }
.detail-sales { color: #9a948e; font-size: 21rpx; }
.detail-price { color: #ed5528; font-size: 43rpx; font-weight: 800; margin-top: 12rpx; }
.detail-price text:first-child { font-size: 22rpx; }
.detail-price text:last-child { color: #a09993; font-size: 20rpx; font-weight: 400; margin-left: 6rpx; }
.detail-description { margin-top: 24rpx; padding: 20rpx 21rpx 19rpx; border: 1rpx solid #f5dfd2; border-radius: 18rpx; background: linear-gradient(145deg, #fffaf7, #fff5ef); box-shadow: 0 6rpx 16rpx rgba(211, 91, 48, .06); }
.detail-desc-heading { display: flex; align-items: center; }
.detail-desc-icon { width: 43rpx; height: 43rpx; flex: 0 0 43rpx; border-radius: 13rpx; color: #fff; background: linear-gradient(135deg, #ff7740, #ed4f28); font-size: 22rpx; font-weight: 800; line-height: 43rpx; text-align: center; box-shadow: 0 5rpx 10rpx rgba(237, 79, 40, .2); }
.detail-desc-heading-copy { margin-left: 12rpx; }
.detail-desc-heading-copy text { display: block; }
.detail-desc-heading-copy text:first-child { color: #3b3835; font-size: 29rpx; font-weight: 800; line-height: 1.2; }
.detail-desc-heading-copy text:last-child { margin-top: 4rpx; color: #c1876e; font-size: 18rpx; line-height: 1.2; }
.detail-desc { margin-top: 15rpx; padding-top: 15rpx; border-top: 1rpx solid rgba(224, 157, 126, .2); color: #625a54; font-size: 26rpx; line-height: 1.75; }
.detail-notice { display: flex; align-items: flex-start; margin-top: 15rpx; padding: 17rpx 18rpx; border: 1rpx solid #f1dfb8; border-radius: 16rpx; background: #fff9eb; }
