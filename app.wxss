.actions { display: flex; justify-content: flex-end; gap: 10rpx; }
.action-button { min-width: 126rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; padding: 0 17rpx; border: 1rpx solid #ddd8d3; border-radius: 17rpx; color: #544f4a; font-size: 22rpx; }
