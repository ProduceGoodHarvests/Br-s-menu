.inline-form { display: flex; align-items: center; gap: 10rpx; padding: 16rpx; margin-bottom: 16rpx; background: #fff; border-radius: 18rpx; }
.inline-form input { flex: 1; min-width: 0; background: #f5f3f0; border-radius: 10rpx; padding: 12rpx; }
.manage-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; background: #fff; padding: 18rpx; border-radius: 16rpx; margin-bottom: 12rpx; }
.manage-row > view:first-child, .manage-row > text:first-child { flex: 1; min-width: 0; word-break: break-all; }
