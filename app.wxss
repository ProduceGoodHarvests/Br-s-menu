/* 订单 */
.orders-page { padding-top: 16rpx; }
.orders-hero { display: flex; align-items: center; justify-content: space-between; padding: 17rpx 5rpx 24rpx; }
.orders-hero > view:first-child text { display: block; }
.orders-hero > view:first-child text:first-child { font-size: 39rpx; font-weight: 800; }
.orders-hero > view:first-child text:last-child { color: #9c9690; font-size: 21rpx; margin-top: 5rpx; }
