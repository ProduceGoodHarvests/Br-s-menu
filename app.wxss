.order-no { color: #aaa49e; font-size: 17rpx; padding: 14rpx 0; border-bottom: 1rpx solid #f0eeeb; }
.order-bottom { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin-top: 17rpx; }
