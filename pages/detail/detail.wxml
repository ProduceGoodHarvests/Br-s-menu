<view class="page detail-page {{themeClass}}" wx:if="{{!loading && dish}}">
  <view class="detail-hero"><image class="hero-image" wx:if="{{dish.img}}" src="{{dish.img}}" mode="aspectFill" /><view class="hero-image placeholder" wx:else>🍲</view><view class="hero-gradient"></view><view class="hero-badge">现点现做</view></view>
  <view class="detail-card">
    <view class="detail-title-row"><view class="detail-title">{{dish.name}}</view><view class="detail-sales">月售 {{dish.sales}}</view></view>
    <view class="detail-price"><text>¥</text>{{unitPrice}}<text>起</text></view>
    <view class="detail-description">
      <view class="detail-desc-heading"><view class="detail-desc-icon">味</view><view class="detail-desc-heading-copy"><text>菜品介绍</text><text>食材与口感</text></view></view>
      <view class="detail-desc">{{dish.desc || '精选新鲜食材，接单后现炒现做。'}}</view>
    </view>
    <view class="detail-notice">
      <view class="detail-notice-icon">!</view>
      <view class="detail-notice-copy"><text>注意事项</text><text>{{dish.notice || '图片仅供参考，菜品以实际出餐为准；如有忌口或食物过敏，请在下单前联系商家。'}}</text></view>
    </view>
    <view class="ingredient-row"><view>✓ 新鲜食材</view><view>✓ 现点现做</view><view>✓ 安心打包</view></view>
  </view>
  <view class="spec-card" wx:for="{{dish.spec}}" wx:key="name" wx:for-item="group">
    <view class="spec-title"><text>{{group.name}}</text><text>请选择</text></view>
    <view class="option-list">
      <view class="option {{selections[group.name] === item.name ? 'active' : ''}}" wx:for="{{group.options}}" wx:key="name" data-group="{{group.name}}" data-value="{{item.name}}" bindtap="selectOption">{{item.name}}{{item.priceDelta > 0 ? ' +¥' + item.priceDelta : ''}}</view>
    </view>
  </view>
  <view class="bottom-bar">
    <view class="quantity"><view data-delta="-1" bindtap="changeQuantity">−</view><text>{{quantity}}</text><view class="plus" data-delta="1" bindtap="changeQuantity">+</view></view>
    <view class="detail-add-button {{dish.stock <= 0 ? 'disabled' : ''}}" wx:if="{{!addedToCart}}" bindtap="addToCart"><view><text>{{dish.stock > 0 ? '加入购物车' : '暂时售罄'}}</text><text wx:if="{{dish.stock > 0}}">已选 {{quantity}} 份</text></view><text wx:if="{{dish.stock > 0}}">{{pricing ? '…' : '¥' + unitPrice}}</text></view>
    <view class="detail-add-button added" wx:else bindtap="goCart"><view><text>已加入，去餐篮</text><text>可继续修改规格或数量</text></view><text>¥{{unitPrice}}</text></view>
  </view>
</view>
<view class="detail-loading {{themeClass}}" wx:else><view class="detail-loading-hero shimmer"></view><view class="detail-loading-card"><view class="skeleton-line wide shimmer"></view><view class="skeleton-line shimmer"></view><view class="skeleton-line short shimmer"></view></view></view>
