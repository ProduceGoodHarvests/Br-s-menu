<view class="mine-page">
  <view class="mine-hero"><view class="mine-decoration one"></view><view class="mine-decoration two"></view><view class="user-card"><view class="avatar-wrap"><text class="avatar-placeholder">🍚</text><view class="avatar-badge">食客</view></view><view class="user-info"><view class="nickname">欢迎来吃饭</view><view class="role-line">无需授权资料，微信身份已安全识别</view></view></view><view class="member-banner"><view><text>会员成长计划</text><text>积分、等级与储值功能已为后续开放预留</text></view><view>敬请期待</view></view></view>
  <view class="stats-section" wx:if="{{member}}"><view class="stat-item"><text class="stat-value">V{{member.level}}</text><text class="stat-label">当前等级</text></view><view class="stat-divider"></view><view class="stat-item"><text class="stat-value">{{member.score}}</text><text class="stat-label">可用积分</text></view><view class="stat-divider"></view><view class="stat-item" bindtap="goCart"><text class="stat-value">{{cartCount}}</text><text class="stat-label">餐篮菜品</text></view></view>
  <view class="admin-entry" wx:if="{{isAdmin}}" bindtap="goMerchant"><view class="admin-entry-icon">▣</view><view><text>商家管理后台</text><text>订单、菜品、桌台和打印管理</text></view><text>进入 ›</text></view>
  <view class="mine-section-title">常用服务</view>
  <view class="menu-section">
    <view class="menu-item" bindtap="goOrders"><view class="menu-icon orange">📋</view><view class="menu-text"><text>我的订单</text><text>查看制作进度和历史订单</text></view><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="goCart"><view class="menu-icon green">🛒</view><view class="menu-text"><text>我的餐篮</text><text>{{cartCount ? '已有 ' + cartCount + ' 件菜品待结算' : '还没有添加菜品'}}</text></view><text class="menu-arrow">›</text></view>
    <view class="menu-item" bindtap="about"><view class="menu-icon blue">i</view><view class="menu-text"><text>关于门店</text><text>查看小程序与门店信息</text></view><text class="menu-arrow">›</text></view>
  </view>
  <view class="mine-footer">微信云开发提供安全服务支持</view>
</view>
