.profile-avatar { width: 100%; height: 100%; border-radius: 34rpx; }
.profile-edit-icon { width: 52rpx; height: 52rpx; margin-left: auto; border: 1rpx solid rgba(255,255,255,.2); border-radius: 16rpx; background: rgba(255,255,255,.12); color: #fff; font-size: 25rpx; line-height: 52rpx; text-align: center; }
.profile-privacy-tip { position: relative; z-index: 1; display: flex; align-items: center; margin-top: 23rpx; padding: 13rpx 16rpx; border: 1rpx solid rgba(255,255,255,.12); border-radius: 15rpx; background: rgba(99,24,7,.13); color: rgba(255,255,255,.82); font-size: 18rpx; }
.profile-privacy-tip text:first-child { width: 31rpx; height: 31rpx; margin-right: 9rpx; border-radius: 50%; background: rgba(255,255,255,.17); font-weight: 700; line-height: 31rpx; text-align: center; }
.profile-menu-icon { color: #7658a2; background: #f1edf8; font-weight: 700; }
.coin-banner { padding: 17rpx 19rpx; border-color: rgba(255,224,145,.32); background: linear-gradient(135deg, rgba(101,46,8,.24), rgba(117,54,7,.12)); }
.coin-banner > view:first-child { flex: 1; min-width: 0; padding-right: 15rpx; }
.coin-banner > view:first-child text:first-child { color: #fff7dd; font-size: 25rpx; }
.coin-banner > view:first-child text:last-child { color: rgba(255,246,216,.72); font-size: 17rpx; }
.member-banner.coin-banner > view:last-child { flex: 0 0 auto; min-width: 155rpx; max-width: 205rpx; padding: 8rpx 13rpx; border: 1rpx solid rgba(255,232,170,.22); border-radius: 17rpx; background: rgba(255,224,142,.13); text-align: right; }
.coin-banner > view:last-child text { display: block; }
.coin-banner > view:last-child text:first-child { overflow: hidden; color: #ffe5a0; font-size: 26rpx; font-weight: 900; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.coin-banner > view:last-child text:last-child { margin-top: 1rpx; color: rgba(255,246,216,.7); font-size: 16rpx; }
.coin-menu-icon { color: #9c6a09; background: linear-gradient(145deg, #fff5d5, #ffe9a9); font-size: 20rpx; font-weight: 900; }
.coin-menu-balance { flex: 0 0 auto; margin-left: 12rpx; color: #ad760d; font-size: 25rpx; font-weight: 800; }
.record-menu-icon { color: #3c7f9b; background: #e9f5fa; font-size: 25rpx; font-weight: 800; }
.membership-card { margin: 0 22rpx 20rpx; padding: 23rpx; border: 1rpx solid #ecd9ab; border-radius: 24rpx; background: linear-gradient(145deg, #fffdf8, #fff5d9); box-shadow: 0 10rpx 28rpx rgba(151,104,19,.08); }
.membership-head { display: flex; align-items: center; justify-content: space-between; }
.membership-head > view:first-child { flex: 1; min-width: 0; }
.membership-head > view:first-child text { display: block; }
.membership-head > view:first-child text:first-child { color: #3b3328; font-size: 29rpx; font-weight: 900; }
.membership-head > view:first-child text:last-child { margin-top: 5rpx; color: #96763d; font-size: 19rpx; }
.membership-discount { min-width: 77rpx; height: 61rpx; margin-left: 16rpx; border-radius: 18rpx; color: #fff; background: linear-gradient(135deg, #d9a439, #b9770d); box-shadow: 0 8rpx 17rpx rgba(174,113,10,.2); font-size: 25rpx; font-weight: 900; line-height: 61rpx; text-align: center; }
.membership-progress-copy { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; color: #806d4a; font-size: 18rpx; }
.membership-progress-copy text:last-child { color: #a27215; font-weight: 800; }
.membership-progress-copy.max { padding: 12rpx 14rpx; border-radius: 14rpx; background: rgba(184,125,17,.08); line-height: 1.45; }
.membership-progress { height: 13rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: #efe4ca; }
.membership-progress view { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #efc45f, #cb8a16); transition: width .25s ease; }
.membership-levels { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; margin-top: 20rpx; }
.membership-level { min-width: 0; padding: 12rpx 4rpx; border: 1rpx solid #eee4cf; border-radius: 14rpx; color: #9b8a6c; background: rgba(255,255,255,.58); text-align: center; }
.membership-level text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.membership-level text:first-child { color: #655842; font-size: 21rpx; font-weight: 900; }
.membership-level text:last-child { margin-top: 4rpx; font-size: 15rpx; }
.membership-level.active { border-color: #d29a2d; color: #9a6710; background: #fff1c5; box-shadow: 0 5rpx 12rpx rgba(174,116,13,.1); }
.membership-level.active text:first-child { color: #a26908; }

.recharge-sheet-mask { z-index: 34; animation: profileMaskIn .2s ease both; }
.recharge-sheet { position: fixed; z-index: 35; left: 0; right: 0; bottom: 0; max-height: 94vh; overflow-y: auto; padding: 15rpx 27rpx 0; border-radius: 32rpx 32rpx 0 0; background: #fff; transform: translateY(105%); transition: transform .28s cubic-bezier(.2,.8,.2,1); }
.recharge-sheet.visible { transform: translateY(0); }
.recharge-sheet .sheet-handle { margin-bottom: 23rpx; }
.recharge-balance { display: flex; align-items: center; justify-content: space-between; padding: 19rpx 20rpx; border: 1rpx solid #f0dfb5; border-radius: 20rpx; color: #7e6940; background: linear-gradient(145deg, #fffaf0, #fff2cc); font-size: 21rpx; }
.recharge-balance text:first-child { flex: 1; min-width: 0; }
.recharge-balance text:last-child { flex: 0 0 auto; margin-left: 16rpx; color: #a66f07; font-size: 28rpx; font-weight: 900; white-space: nowrap; }
.recharge-label { margin-top: 25rpx; color: #423d38; font-size: 23rpx; font-weight: 800; }
.recharge-presets { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; margin-top: 13rpx; }
.recharge-preset { height: 70rpx; border: 2rpx solid #ece7df; border-radius: 17rpx; color: #746d65; background: #faf9f7; font-size: 23rpx; font-weight: 700; line-height: 66rpx; text-align: center; }
.recharge-preset.active { border-color: #e1ad38; color: #996506; background: #fff5d8; }
.recharge-input { display: flex; align-items: center; height: 84rpx; margin-top: 15rpx; padding: 0 19rpx; border: 2rpx solid #eadcbf; border-radius: 19rpx; background: #fffdf8; }
.recharge-input input { flex: 1; height: 100%; color: #9d6807; font-size: 32rpx; font-weight: 800; }
.recharge-input text { color: #8f7a53; font-size: 22rpx; }
.recharge-note { display: flex; align-items: flex-start; margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 16rpx; color: #8e867d; background: #f7f5f2; font-size: 18rpx; line-height: 1.5; }
.recharge-note text:first-child { width: 29rpx; height: 29rpx; flex: 0 0 29rpx; margin: 0 9rpx 0 0; border-radius: 50%; color: #fff; background: #dca22b; font-size: 17rpx; font-weight: 800; line-height: 29rpx; text-align: center; }
.recharge-submit { background: linear-gradient(135deg, #efb83f, #d5941d); box-shadow: 0 10rpx 24rpx rgba(201,137,24,.22); }

.profile-sheet-mask { animation: profileMaskIn .2s ease both; }
.profile-sheet { position: fixed; z-index: 31; left: 0; right: 0; bottom: 0; max-height: 94vh; overflow-y: auto; padding: 15rpx 27rpx 0; border-radius: 32rpx 32rpx 0 0; background: #fff; transform: translateY(105%); transition: transform .28s cubic-bezier(.2,.8,.2,1); }
.profile-sheet.visible { transform: translateY(0); }
.profile-sheet .sheet-handle { margin-bottom: 23rpx; }
.profile-sheet-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 27rpx; }
.profile-sheet-head > view:first-child text { display: block; }
.profile-sheet-head > view:first-child text:first-child { color: #302d2a; font-size: 35rpx; font-weight: 800; }
.profile-sheet-head > view:first-child text:last-child { margin-top: 6rpx; color: #9d9791; font-size: 20rpx; }
.profile-sheet-head > view:last-child { width: 53rpx; height: 53rpx; border-radius: 50%; background: #f2f0ed; color: #8d8781; font-size: 35rpx; line-height: 49rpx; text-align: center; }
.profile-avatar-picker { display: flex; align-items: center; width: 100%; min-height: 126rpx; padding: 18rpx; border: 1rpx solid #ece8e4; border-radius: 22rpx; background: #faf8f6; text-align: left; }
.profile-avatar-picker::after { border: 0; }
.profile-avatar-preview { position: relative; width: 88rpx; height: 88rpx; flex: 0 0 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 26rpx; background: linear-gradient(145deg, #fff1e8, #ffd8c5); font-size: 45rpx; }
.profile-avatar-preview image { width: 100%; height: 100%; border-radius: 26rpx; }
.profile-avatar-preview view { position: absolute; right: -6rpx; bottom: -6rpx; width: 34rpx; height: 34rpx; border: 3rpx solid #fff; border-radius: 50%; background: #ee582e; color: #fff; font-size: 17rpx; line-height: 30rpx; text-align: center; }
.avatar-picker-copy { flex: 1; min-width: 0; margin-left: 17rpx; }
.avatar-picker-copy text { display: block; }
.avatar-picker-copy text:first-child { color: #393532; font-size: 25rpx; font-weight: 700; }
.avatar-picker-copy text:last-child { margin-top: 5rpx; color: #9d9791; font-size: 18rpx; }
.picker-arrow { color: #aaa49e; font-size: 38rpx; }
.profile-field { margin-top: 24rpx; }
.profile-field-label { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.profile-field-label text:first-child { color: #4a4541; font-size: 23rpx; font-weight: 700; }
.profile-field-label text:last-child { color: #aaa49e; font-size: 18rpx; }
.profile-name-input { display: flex; align-items: center; height: 82rpx; padding: 0 18rpx; border: 2rpx solid #ebe7e3; border-radius: 18rpx; background: #faf9f7; }
.profile-name-input > text { width: 42rpx; color: #ed633b; font-size: 27rpx; }
.profile-name-input input { flex: 1; height: 100%; color: #34312e; font-size: 26rpx; }
.wechat-profile-fill { display: flex; align-items: center; margin-top: 22rpx; padding: 16rpx 18rpx; border-radius: 18rpx; color: #315f3d; background: #eef8f0; }
.wechat-profile-fill.disabled { opacity: .6; }
.wechat-profile-fill > text:first-child { width: 51rpx; height: 51rpx; flex: 0 0 51rpx; border-radius: 16rpx; background: #57aa69; color: #fff; font-size: 23rpx; font-weight: 800; line-height: 51rpx; text-align: center; }
.wechat-profile-fill > view { flex: 1; min-width: 0; margin-left: 13rpx; }
.wechat-profile-fill > view text { display: block; }
.wechat-profile-fill > view text:first-child { font-size: 22rpx; font-weight: 700; }
.wechat-profile-fill > view text:last-child { margin-top: 3rpx; color: #7a9a82; font-size: 17rpx; }
.wechat-profile-fill > text:last-child { color: #7b9d83; font-size: 35rpx; }
.profile-consent { display: flex; align-items: flex-start; margin-top: 19rpx; padding: 13rpx 15rpx; border-radius: 15rpx; color: #918a84; background: #f7f5f2; font-size: 17rpx; line-height: 1.55; }
.profile-consent text:first-child { width: 27rpx; height: 27rpx; flex: 0 0 27rpx; margin: 1rpx 9rpx 0 0; border-radius: 50%; background: #e9e5e1; color: #6d6863; font-size: 15rpx; line-height: 27rpx; text-align: center; }
.profile-save-button { width: 100%; height: 84rpx; margin-top: 23rpx; border-radius: 21rpx; font-size: 27rpx; line-height: 84rpx; }

@keyframes profileMaskIn { from { opacity: 0; } to { opacity: 1; } }
