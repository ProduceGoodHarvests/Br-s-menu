<view class="page admin-page">
  <view class="admin-hero {{store.isOpen ? '' : 'paused'}}"><view><text>商家工作台</text><text>{{store.isOpen ? '实时掌握门店订单与经营状态' : '已暂停接收新订单，现有订单可继续处理'}}</text></view><view class="admin-live {{store.isOpen ? '' : 'paused'}}"><view></view>{{store.isOpen ? '营业中' : '暂停营业'}}</view></view>
  <view class="business-control {{store.isOpen ? 'open' : 'paused'}}">
    <view class="business-control-icon">{{store.isOpen ? '◉' : 'Ⅱ'}}</view>
    <view class="business-control-copy"><text>{{store.isOpen ? '门店正在营业' : '门店已暂停营业'}}</text><text>{{store.isOpen ? '用户可以正常点餐和下单' : (store.pauseReason || '暂停期间不会接收新的订单')}}</text></view>
    <button class="business-toggle {{store.isOpen ? 'pause' : 'resume'}}" loading="{{storeUpdating}}" disabled="{{storeUpdating}}" bindtap="toggleStoreStatus">{{store.isOpen ? '暂停营业' : '恢复营业'}}</button>
  </view>
  <view class="summary-grid">
    <view class="summary-card orange"><view class="summary-icon">📋</view><text>{{summary.todayOrders || 0}}</text><view>今日订单</view><text>实时</text></view><view class="summary-card green"><view class="summary-icon">¥</view><text>{{summary.revenue || 0}}</text><view>今日营收</view><text>已支付</text></view><view class="summary-card blue"><view class="summary-icon">▦</view><text>{{summary.occupiedTables || 0}}</text><view>占用桌台</view><text>堂食</text></view><view class="summary-card red"><view class="summary-icon">!</view><text>{{summary.printFailed || 0}}</text><view>打印异常</view><text>待处理</text></view>
  </view>
  <view class="admin-section-title"><text>快捷管理</text><text>常用功能</text></view><view class="admin-nav"><view bindtap="goDishes"><text>🍲</text><view><text>菜品管理</text><text>价格 · 库存 · 上下架</text></view><text>›</text></view><view bindtap="goData"><text>▦</text><view><text>分类桌台</text><text>菜单分类 · 桌台状态</text></view><text>›</text></view><view bindtap="goAdmins"><text>⚙</text><view><text>权限打印</text><text>管理员 · 后厨小票</text></view><text>›</text></view><view bindtap="goUsers"><text>👥</text><view><text>用户管理</text><text>{{summary.totalMembers || 0}} 位用户 · 等级积分金币</text></view><text>›</text></view></view>
  <view class="order-processing-head">
    <view><text>订单处理</text><text>按状态依次接单、制作、出餐</text></view>
    <view><text>{{orders.length}}</text><text>笔订单</text></view>
  </view>
  <view class="order-filter-panel">
    <view class="filter-panel-title"><text>筛选订单</text><text>每 8 秒自动刷新</text></view>
    <view class="filter-row"><picker range="{{types}}" range-key="label" bindchange="onTypeFilter"><view class="filter">场景 <text>{{typeFilter || '全部'}}</text><text>›</text></view></picker><picker range="{{statuses}}" range-key="label" bindchange="onStatusFilter"><view class="filter">状态 <text>{{statusFilter || '全部'}}</text><text>›</text></view></picker></view>
  </view>
  <view class="loading order-processing-loading" wx:if="{{loading}}">订单数据加载中...</view>
  <view class="admin-order order-card-{{item.statusClass}}" wx:for="{{orders}}" wx:key="_id">
    <view class="admin-order-top">
      <view class="admin-order-scene"><view class="scene-icon {{item.statusClass}}">{{item.typeIcon}}</view><view><text>{{item.typeText}}{{item.tableNo ? ' · ' + item.tableNo + '桌' : ''}}</text><text>{{item.timeText}}</text></view></view>
      <view class="admin-status-pill {{item.statusClass}}"><view></view>{{item.statusText}}</view>
    </view>
    <view class="admin-order-id"><text>订单号 {{item.orderNo}}</text><text>{{item.goodsCount}} 件菜品</text></view>
    <view class="admin-order-goods">
      <view class="admin-goods-row" wx:for="{{item.goodsList}}" wx:key="goodsId" wx:for-item="goods"><view><text>{{goods.name}}</text><text wx:if="{{goods.specs.length}}">{{goods.specs[0].value}}</text></view><text>×{{goods.quantity}}</text><text>¥{{goods.subtotal}}</text></view>
    </view>
    <view class="admin-order-remark" wx:if="{{item.remark}}"><text>备注</text><text>{{item.remark}}</text></view>
    <view class="admin-payment-summary">
      <view><text>商品合计</text><text>¥{{item.totalPriceText}}</text></view>
      <view wx:if="{{item.hasCoinPayment}}"><text>金币支付</text><text class="coin-value">{{item.coinUsedText}} 金币</text></view>
      <view><text>{{item.isCoinOnly ? '支付方式' : '微信实付'}}</text><text class="pay-value">{{item.isCoinOnly ? '虚拟金币支付' : '¥' + item.payPriceText}}</text></view>
    </view>
    <view class="admin-actions"><button class="print-action" data-id="{{item._id}}" bindtap="reprint">补打</button><button class="danger cancel-action" wx:if="{{item.orderStatus === 'pending_payment'}}" data-id="{{item._id}}" data-coin="{{item.coinUsed}}" data-status="cancelled" bindtap="updateStatus">取消订单</button><button class="primary-flow" wx:if="{{item.orderStatus === 'paid'}}" data-id="{{item._id}}" data-status="accepted" bindtap="updateStatus">确认接单</button><button class="primary-flow" wx:if="{{item.orderStatus === 'paid' || item.orderStatus === 'accepted'}}" data-id="{{item._id}}" data-status="cooking" bindtap="updateStatus">开始制作</button><button class="primary-flow" wx:if="{{item.orderStatus === 'cooking' || item.orderStatus === 'accepted'}}" data-id="{{item._id}}" data-status="ready" bindtap="updateStatus">确认出餐</button><button class="primary-flow complete" wx:if="{{item.orderStatus === 'ready' || item.orderStatus === 'cooking'}}" data-id="{{item._id}}" data-status="completed" bindtap="updateStatus">完成订单</button></view>
  </view>
  <view wx:if="{{!loading && !orders.length}}" class="admin-order-empty"><text>暂无符合条件的订单</text><text>新的金币订单会自动显示在这里</text></view>
</view>
