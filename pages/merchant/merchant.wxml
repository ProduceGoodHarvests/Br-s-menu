<view class="page admin-page">
  <view class="admin-hero"><view><text>商家工作台</text><text>实时掌握门店订单与经营状态</text></view><view class="admin-live"><view></view>营业中</view></view>
  <view class="summary-grid">
    <view class="summary-card orange"><view class="summary-icon">📋</view><text>{{summary.todayOrders || 0}}</text><view>今日订单</view><text>实时</text></view><view class="summary-card green"><view class="summary-icon">¥</view><text>{{summary.revenue || 0}}</text><view>今日营收</view><text>已支付</text></view><view class="summary-card blue"><view class="summary-icon">▦</view><text>{{summary.occupiedTables || 0}}</text><view>占用桌台</view><text>堂食</text></view><view class="summary-card red"><view class="summary-icon">!</view><text>{{summary.printFailed || 0}}</text><view>打印异常</view><text>待处理</text></view>
  </view>
  <view class="admin-section-title"><text>快捷管理</text><text>常用功能</text></view><view class="admin-nav"><view bindtap="goDishes"><text>🍲</text><view><text>菜品管理</text><text>价格 · 库存 · 上下架</text></view><text>›</text></view><view bindtap="goData"><text>▦</text><view><text>分类桌台</text><text>菜单分类 · 桌台状态</text></view><text>›</text></view><view bindtap="goAdmins"><text>⚙</text><view><text>权限打印</text><text>管理员 · 后厨小票</text></view><text>›</text></view><view bindtap="goUsers"><text>👥</text><view><text>用户管理</text><text>{{summary.totalMembers || 0}} 位用户 · 等级积分余额</text></view><text>›</text></view></view>
  <view class="admin-section-title"><text>订单处理</text><text>每 8 秒自动刷新</text></view>
  <view class="filter-row"><picker range="{{types}}" range-key="label" bindchange="onTypeFilter"><view class="filter">场景：{{typeFilter || '全部'}} ›</view></picker><picker range="{{statuses}}" range-key="label" bindchange="onStatusFilter"><view class="filter">状态：{{statusFilter || '全部'}} ›</view></picker></view>
  <view class="loading" wx:if="{{loading}}">后台数据加载中...</view>
  <view class="admin-order" wx:for="{{orders}}" wx:key="_id">
    <view class="order-head"><view><text class="type-badge">{{item.typeText}}</text> {{item.tableNo}}</view><text class="status">{{item.statusText}}</text></view>
    <view class="order-no">{{item.orderNo}} · {{item.timeText}}</view>
    <view class="order-goods" wx:for="{{item.goodsList}}" wx:key="goodsId" wx:for-item="goods"><text>{{goods.name}} x{{goods.quantity}}</text><text>¥{{goods.subtotal}}</text></view>
    <view class="remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
    <view class="admin-actions"><button data-id="{{item._id}}" bindtap="reprint">补打</button><button class="danger" wx:if="{{item.orderStatus === 'pending_payment'}}" data-id="{{item._id}}" data-status="cancelled" bindtap="updateStatus">取消未支付单</button><button wx:if="{{item.orderStatus === 'paid'}}" data-id="{{item._id}}" data-status="accepted" bindtap="updateStatus">接单</button><button wx:if="{{item.orderStatus === 'paid' || item.orderStatus === 'accepted'}}" data-id="{{item._id}}" data-status="cooking" bindtap="updateStatus">制作</button><button wx:if="{{item.orderStatus === 'cooking' || item.orderStatus === 'accepted'}}" data-id="{{item._id}}" data-status="ready" bindtap="updateStatus">出餐</button><button class="primary small" wx:if="{{item.orderStatus === 'ready' || item.orderStatus === 'cooking'}}" data-id="{{item._id}}" data-status="completed" bindtap="updateStatus">完成</button></view>
  </view>
</view>
