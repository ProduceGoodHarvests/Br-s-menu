<view class="page orders-page">
  <view class="empty-card order-empty order-load-error" wx:if="{{!loading && error}}"><view class="empty-illustration"><text>!</text><view></view></view><view class="empty-title">订单暂时加载失败</view><view class="empty-desc">{{error}}</view><view class="empty-primary" bindtap="retryLoadOrders">重新加载 <text>›</text></view></view>
  <view class="orders-hero"><view><text>我的订单</text><text>每一道菜，都在认真准备</text></view><view>🥢</view></view>
  <view class="tabs order-tabs"><view class="tab {{activeTab === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-value="{{item.value}}" bindtap="switchTab"><text>{{item.label}}</text><view wx:if="{{activeTab === item.value}}"></view></view></view>
  <view class="order-loading" wx:if="{{loading}}"><view class="order-loading-card" wx:for="{{skeletons}}" wx:key="*this"><view class="skeleton-line wide shimmer"></view><view class="skeleton-line shimmer"></view><view class="skeleton-line short shimmer"></view></view></view>
  <view class="empty-card order-empty" wx:elif="{{!visibleOrders.length}}"><view class="empty-illustration"><text>📋</text><view></view></view><view class="empty-title">这里还没有订单</view><view class="empty-desc">下单后可以在这里查看制作进度</view></view>
  <view class="order-card" wx:for="{{visibleOrders}}" wx:key="_id" data-id="{{item._id}}" bindtap="goOrderDetail">
    <view class="order-head"><view class="order-scene"><view>{{item.sceneIcon}}</view><view><text>{{item.typeText}}{{item.tableNo ? ' · ' + item.tableNo + '桌' : ''}}</text><text>{{item.timeText}}</text></view></view><text class="order-status {{item.statusClass}}">{{item.statusText}}</text></view>
    <view class="order-progress" wx:if="{{item.progress > 0 && item.orderStatus !== 'completed'}}"><view class="progress-line"><view style="width: {{(item.progress - 1) * 25}}%"></view></view><view class="progress-node {{item.progress >= 1 ? 'active' : ''}}"><text>✓</text><text>已支付</text></view><view class="progress-node {{item.progress >= 2 ? 'active' : ''}}"><text>2</text><text>已接单</text></view><view class="progress-node {{item.progress >= 3 ? 'active' : ''}}"><text>3</text><text>制作中</text></view><view class="progress-node {{item.progress >= 4 ? 'active' : ''}}"><text>4</text><text>待取餐</text></view><view class="progress-node {{item.progress >= 5 ? 'active' : ''}}"><text>5</text><text>已完成</text></view></view>
    <view class="payment-alert" wx:if="{{item.canCancel}}"><view>!</view><view><text>旧支付订单已停用</text><text>当前仅支持虚拟金币支付，请取消后重新下单</text></view></view>
    <view class="merchant-reject-alert" wx:if="{{item.isRejected}}"><view>!</view><view><text>商家已拒绝出餐</text><text>{{item.rejectReason}}</text></view></view>
    <view class="order-goods-wrap"><view class="order-goods" wx:for="{{item.goodsList}}" wx:key="goodsId" wx:for-item="goods"><view><text>{{goods.name}}</text><text wx:if="{{goods.specs.length}}">{{goods.specs[0].value}}</text></view><text>x{{goods.quantity}}</text><text>¥{{goods.subtotal}}</text></view></view>
    <view class="remark" wx:if="{{item.remark}}"><text>备注</text>{{item.remark}}</view>
    <view class="order-no">订单号 {{item.orderNo}}</view>
    <view class="order-bottom">
      <view class="order-amount coin-order-amount" wx:if="{{item.isCoinOnly}}"><text>合计</text><text>{{item.coinUsedText}}</text><text>金币</text></view>
      <view class="order-amount" wx:else><text>{{item.isMixedPayment ? '微信实付' : '合计'}}</text><text>¥</text><text>{{item.payPriceText}}</text><view wx:if="{{item.isMixedPayment}}">+ {{item.coinUsedText}} 金币</view></view>
      <view class="actions"><view class="action-button ghost" wx:if="{{item.canCancel}}" data-id="{{item._id}}" data-coin="{{item.coinUsed}}" catchtap="cancelOrder">取消旧订单</view><view class="action-button" wx:if="{{item.canReorder}}" data-id="{{item._id}}" catchtap="reorder">再来一单</view></view>
    </view>
    <view class="order-detail-entry">查看订单详情 <text>›</text></view>
  </view>
</view>
