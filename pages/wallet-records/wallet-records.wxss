.wallet-records-page { min-height: 100vh; padding: 20rpx 22rpx 60rpx; background: #f6f5f3; }
.record-amount { min-width: 150rpx; }
.record-amount text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wallet-hero { display: flex; align-items: center; justify-content: space-between; overflow: hidden; min-height: 184rpx; padding: 28rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #c58a21, #e3b64e); box-shadow: 0 16rpx 34rpx rgba(181,123,22,.22); }.wallet-hero > view:first-child text { display: block; }.wallet-hero > view:first-child text:first-child { font-size: 37rpx; font-weight: 900; }.wallet-hero > view:first-child text:last-child { margin-top: 9rpx; color: rgba(255,255,255,.8); font-size: 20rpx; }.wallet-balance { min-width: 156rpx; padding: 13rpx 15rpx; border: 1rpx solid rgba(255,255,255,.25); border-radius: 19rpx; background: rgba(112,73,7,.15); text-align: right; }.wallet-balance text { display: block; }.wallet-balance text:first-child { color: rgba(255,255,255,.72); font-size: 17rpx; }.wallet-balance text:nth-child(2) { margin-top: 4rpx; font-size: 31rpx; font-weight: 900; }.wallet-balance text:last-child { margin-top: 1rpx; color: rgba(255,255,255,.75); font-size: 17rpx; }
.wallet-balance { min-width: 175rpx; max-width: 220rpx; }
.wallet-balance text:nth-child(2) { overflow: hidden; font-size: 28rpx; text-overflow: ellipsis; white-space: nowrap; }
.wallet-tabs { display: flex; margin: 20rpx 0; padding: 6rpx; border-radius: 19rpx; background: #fff; box-shadow: 0 7rpx 20rpx rgba(50,38,28,.035); }.wallet-tab { flex: 1; padding: 15rpx 4rpx; border-radius: 14rpx; color: #928a82; font-size: 22rpx; text-align: center; }.wallet-tab.active { color: #a66f07; background: #fff4d9; font-weight: 800; }
.record-loading { padding-top: 2rpx; }.record-skeleton { display: flex; align-items: center; min-height: 114rpx; margin-bottom: 15rpx; padding: 20rpx; border-radius: 23rpx; background: #fff; }.record-skeleton-icon { width: 62rpx; height: 62rpx; margin-right: 17rpx; border-radius: 20rpx; }.record-skeleton > view:last-child { flex: 1; }.record-skeleton .skeleton-line { width: 50%; }.record-skeleton .skeleton-line.short { width: 30%; }
.record-card { display: flex; align-items: center; min-height: 120rpx; margin-bottom: 15rpx; padding: 20rpx; border: 1rpx solid rgba(58,45,35,.04); border-radius: 23rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(50,38,28,.035); }.record-card.link:active { transform: scale(.99); background: #fffdf9; }.record-icon { width: 60rpx; height: 60rpx; flex: 0 0 60rpx; border-radius: 19rpx; font-size: 31rpx; font-weight: 800; line-height: 59rpx; text-align: center; }.record-icon.consume { color: #d45a3d; background: #fff0eb; }.record-icon.recharge { color: #b0780d; background: #fff3d2; }.record-icon.refund { color: #328b6a; background: #eaf8f1; }.record-icon.adjustment { color: #5076a5; background: #edf3fb; }.record-main { flex: 1; min-width: 0; margin-left: 15rpx; }.record-main > view { display: flex; align-items: center; }.record-main > view text:first-child { overflow: hidden; color: #403a35; font-size: 25rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.record-main > view text:last-child { margin-left: 8rpx; padding: 3rpx 7rpx; border-radius: 7rpx; color: #988b7d; background: #f5f2ef; font-size: 16rpx; }.record-main > text { display: block; overflow: hidden; margin-top: 5rpx; color: #958c84; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }.record-main > text:last-child { margin-top: 4rpx; color: #b1a9a2; font-size: 17rpx; }.record-amount { flex: 0 0 auto; margin-left: 10rpx; text-align: right; }.record-amount text { display: block; }.record-amount text:first-child { font-size: 23rpx; font-weight: 900; }.record-amount.income text:first-child { color: #328b6a; }.record-amount.expense text:first-child { color: #d5583b; }.record-amount.pending text:first-child { color: #9b938b; }.record-amount text:last-child { margin-top: 6rpx; color: #b18944; font-size: 17rpx; }
.record-error, .record-empty { display: flex; min-height: 500rpx; flex-direction: column; align-items: center; justify-content: center; padding: 35rpx; text-align: center; }.record-error > view:first-child { width: 80rpx; height: 80rpx; border-radius: 26rpx; color: #d0644a; background: #fff0eb; font-size: 43rpx; font-weight: 800; line-height: 80rpx; }.record-error text:first-of-type, .record-empty text:first-of-type { margin-top: 24rpx; color: #403a35; font-size: 29rpx; font-weight: 800; }.record-error text:last-of-type, .record-empty text:last-of-type { margin-top: 10rpx; color: #9b938c; font-size: 21rpx; line-height: 1.6; }.record-error > view:last-child { min-width: 205rpx; height: 72rpx; margin-top: 28rpx; border-radius: 20rpx; color: #fff; background: linear-gradient(135deg, #efb83f, #d5941d); font-size: 24rpx; font-weight: 800; line-height: 72rpx; }.record-empty > view { color: #d5a13a; font-size: 82rpx; }.wallet-footnote { margin: 27rpx 0 8rpx; color: #aaa299; font-size: 18rpx; text-align: center; }
