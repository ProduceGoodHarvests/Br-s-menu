<view class="page admin-page">
  <view class="section-head"><text>菜品管理</text><button class="primary small" bindtap="addDish">新增菜品</button></view>
  <view class="manage-card" wx:for="{{dishes}}" wx:key="_id">
    <image class="manage-image" wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" /><view class="manage-image placeholder" wx:else>🍲</view>
    <view class="manage-main"><view class="manage-name">{{item.name}} <text class="off" wx:if="{{!item.status}}">已下架</text></view><view>¥{{item.price}} · 库存 {{item.stock}} · 排序 {{item.sort}}</view><view class="manage-actions"><button data-index="{{index}}" bindtap="editDish">编辑</button><button class="danger" data-id="{{item._id}}" bindtap="deleteDish">删除</button></view></view>
  </view>
  <view class="modal-mask" wx:if="{{formVisible}}"><scroll-view scroll-y class="form-modal"><view class="modal-title">{{editingId ? '编辑菜品' : '新增菜品'}}</view>
    <view class="field"><text>菜名</text><input value="{{form.name}}" data-field="name" bindinput="onField" /></view>
    <picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategory"><view class="field"><text>分类</text><text>{{categories[categoryIndex].name || '请选择'}} ›</text></view></picker>
    <view class="field"><text>售价</text><input type="digit" value="{{form.price}}" data-field="price" bindinput="onField" /></view><view class="field"><text>库存</text><input type="number" value="{{form.stock}}" data-field="stock" bindinput="onField" /></view><view class="field"><text>排序</text><input type="number" value="{{form.sort}}" data-field="sort" bindinput="onField" /></view>
    <view class="field"><text>上架</text><switch checked="{{form.status}}" bindchange="onStatus" color="#ff6a2a" /></view>
    <view class="field column"><text>食材说明</text><textarea value="{{form.desc}}" data-field="desc" bindinput="onField" /></view>
    <view class="field column"><text>规格（例：辣度:微辣,中辣;份量:标准,加量+6）</text><textarea value="{{form.specText}}" data-field="specText" bindinput="onField" /></view>
    <view class="upload" bindtap="chooseImage"><image wx:if="{{form.img}}" src="{{form.img}}" mode="aspectFill" /><text wx:else>＋ 上传菜品图（云函数鉴权）</text></view>
    <view class="modal-actions"><button bindtap="closeForm">取消</button><button class="primary" loading="{{saving}}" bindtap="saveDish">保存</button></view>
  </scroll-view></view>
</view>
