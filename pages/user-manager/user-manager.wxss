.user-page { background: #f6f5f3; }
.user-hero { display: flex; align-items: center; justify-content: space-between; padding: 28rpx; margin-bottom: 18rpx; border-radius: 28rpx; background: linear-gradient(135deg, #2f2a27, #5a4034); color: #fff; box-shadow: 0 14rpx 34rpx rgba(50, 38, 30, .14); }
.user-hero text { display: block; }
.user-hero > view:first-child text:first-child { font-size: 38rpx; font-weight: 800; }
.user-hero > view:first-child text:last-child { margin-top: 8rpx; color: rgba(255,255,255,.72); font-size: 22rpx; }
.user-total { min-width: 136rpx; padding: 16rpx; border-radius: 22rpx; background: rgba(255,255,255,.12); text-align: center; }
.user-total text:first-child { font-size: 38rpx; font-weight: 800; }
.user-total text:last-child { margin-top: 2rpx; color: rgba(255,255,255,.68); font-size: 19rpx; }
.user-search { margin-top: 0; }
.user-tabs { position: sticky; top: 0; z-index: 5; }
.member-card { display: flex; align-items: stretch; gap: 20rpx; padding: 22rpx; animation: fadeUp .24s ease both; }
.member-card.disabled { opacity: .76; }
.member-avatar { width: 92rpx; height: 92rpx; flex: 0 0 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: linear-gradient(145deg, #fff1e8, #ffd8c5); color: #e8542b; font-size: 23rpx; font-weight: 800; }
.member-avatar image { width: 100%; height: 100%; border-radius: 24rpx; }
.member-card.disabled .member-avatar { background: #ece9e5; color: #8f8983; }
.member-main { flex: 1; min-width: 0; }
.member-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.member-openid { flex: 1; min-width: 0; }
.member-openid text { display: block; }
.member-openid text:first-child { color: #2d2926; font-size: 29rpx; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.member-openid text:last-child { margin-top: 5rpx; color: #9c9690; font-size: 20rpx; }
.status-pill { flex: 0 0 auto; padding: 8rpx 15rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 700; }
.status-pill.ok { background: #edf8eb; color: #4d8a46; }
.status-pill.off { background: #fff0ec; color: #d84a3a; }
.member-badges { display: flex; flex: 0 0 auto; flex-direction: column; align-items: flex-end; gap: 7rpx; }
.admin-pill { max-width: 170rpx; padding: 7rpx 13rpx; overflow: hidden; border-radius: 999rpx; font-size: 18rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.admin-pill.super_admin { color: #85601b; background: #fff5d9; }
.admin-pill.operator { color: #5e4d99; background: #f1edfb; }
.admin-pill.kitchen { color: #36777f; background: #eaf6f7; }
.admin-pill.admin-off { color: #8c8680; background: #ebe8e4; }
.member-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 18rpx; }
.member-metrics > view { min-width: 0; padding: 14rpx 10rpx; border-radius: 16rpx; background: #f8f6f3; }
.member-metrics text { display: block; text-align: center; }
.member-metrics text:first-child { color: #302d2a; font-size: 24rpx; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.member-metrics text:last-child { margin-top: 5rpx; color: #9b958f; font-size: 18rpx; }
.member-remark { margin-top: 14rpx; padding: 13rpx 16rpx; border-radius: 14rpx; background: #fff9ed; color: #7d6a42; font-size: 22rpx; line-height: 1.5; }
.member-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 18rpx; }
.member-actions > view { min-width: 140rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; background: #f0ede9; color: #746e68; font-size: 23rpx; font-weight: 700; }
.member-actions .primary-action { background: #fff0e9; color: #ee552a; }
.member-actions .admin-action { color: #66509a; background: #f1edfa; }
.member-actions .admin-action.self-admin { color: #928b84; background: #efedea; }
.metric-skeleton { height: 70rpx; border-radius: 16rpx; }
.loading-more, .list-end { padding: 28rpx 0 48rpx; text-align: center; color: #aaa49e; font-size: 22rpx; }
.member-sheet { position: fixed; z-index: 31; left: 0; right: 0; bottom: 0; padding: 14rpx 25rpx 0; border-radius: 32rpx 32rpx 0 0; background: #fff; transform: translateY(105%); transition: transform .28s cubic-bezier(.2,.8,.2,1); }
.member-sheet.visible { transform: translateY(0); }
.form-row { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; border-bottom: 1rpx solid #f0eeeb; }
.form-row > text, .form-block > text { color: #3b3835; font-size: 25rpx; font-weight: 700; }
.form-row input { width: 260rpx; height: 72rpx; padding: 0 18rpx; border-radius: 16rpx; background: #f7f5f2; text-align: right; font-size: 25rpx; }
.switch-row > view text { display: block; }
.switch-row > view text:first-child { color: #3b3835; font-size: 25rpx; font-weight: 700; }
.switch-row > view text:last-child { margin-top: 4rpx; color: #9b958f; font-size: 20rpx; }
.form-block { padding: 22rpx 0 0; }
.form-block textarea { width: 100%; height: 150rpx; margin-top: 15rpx; padding: 18rpx; border-radius: 18rpx; background: #f7f5f2; color: #302d2a; font-size: 24rpx; line-height: 1.5; }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.cancel-button, .save-button { flex: 1; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; font-size: 27rpx; font-weight: 800; }
.cancel-button { background: #f0ede9; color: #706a64; }
.save-button { background: linear-gradient(135deg, #ff773e, #f05228); color: #fff; box-shadow: 0 10rpx 24rpx rgba(240, 82, 40, .2); }
.save-button.disabled { opacity: .55; }
.admin-role-sheet { position: fixed; z-index: 32; left: 0; right: 0; bottom: 0; max-height: 94vh; overflow-y: auto; padding: 14rpx 25rpx 0; border-radius: 32rpx 32rpx 0 0; background: #fff; transform: translateY(105%); transition: transform .28s cubic-bezier(.2,.8,.2,1); }
.admin-role-sheet.visible { transform: translateY(0); }
.admin-sheet-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22rpx; }
.admin-sheet-head > view:first-child { flex: 1; min-width: 0; }
.admin-sheet-head > view:first-child text { display: block; }
.admin-sheet-head > view:first-child text:first-child { color: #302d2a; font-size: 34rpx; font-weight: 800; }
.admin-sheet-head > view:first-child text:last-child { margin-top: 6rpx; overflow: hidden; color: #9b958f; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.admin-sheet-head > view:last-child { width: 53rpx; height: 53rpx; flex: 0 0 53rpx; margin-left: 15rpx; border-radius: 50%; background: #f2f0ed; color: #8d8781; font-size: 35rpx; line-height: 49rpx; text-align: center; }
.admin-security-note { display: flex; align-items: center; margin-bottom: 21rpx; padding: 16rpx; border-radius: 17rpx; color: #9a6038; background: #fff5e9; }
.admin-security-note > text { width: 39rpx; height: 39rpx; flex: 0 0 39rpx; border-radius: 50%; color: #fff; background: #e68a43; font-weight: 800; line-height: 39rpx; text-align: center; }
.admin-security-note > view { flex: 1; margin-left: 12rpx; }
.admin-security-note > view text { display: block; }
.admin-security-note > view text:first-child { font-size: 22rpx; font-weight: 700; }
.admin-security-note > view text:last-child { margin-top: 3rpx; font-size: 18rpx; line-height: 1.45; opacity: .82; }
.admin-role-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.admin-role-title text:first-child { color: #3d3935; font-size: 24rpx; font-weight: 800; }
.admin-role-title text:last-child { color: #aaa49e; font-size: 18rpx; }
.admin-role-list { display: flex; flex-direction: column; gap: 11rpx; }
.admin-role-option { display: flex; align-items: center; min-height: 103rpx; padding: 15rpx; border: 2rpx solid #ece8e4; border-radius: 19rpx; background: #fff; }
.admin-role-option.active { border-color: #ef6a40; background: #fff8f4; }
.admin-role-option.locked { opacity: .65; }
.role-icon { width: 61rpx; height: 61rpx; flex: 0 0 61rpx; border-radius: 18rpx; color: #5c4c94; background: #f1edfb; font-size: 23rpx; font-weight: 800; line-height: 61rpx; text-align: center; }
.role-icon.kitchen { color: #34757d; background: #eaf6f7; }
.role-icon.super_admin { color: #89611b; background: #fff4d7; }
.role-copy { flex: 1; min-width: 0; margin-left: 14rpx; }
.role-copy text { display: block; }
.role-copy text:first-child { color: #393532; font-size: 24rpx; font-weight: 800; }
.role-copy text:last-child { margin-top: 4rpx; color: #9b958f; font-size: 18rpx; line-height: 1.4; }
.role-check { width: 39rpx; height: 39rpx; flex: 0 0 39rpx; margin-left: 10rpx; border: 2rpx solid #ddd8d3; border-radius: 50%; color: transparent; font-size: 22rpx; line-height: 35rpx; text-align: center; }
.admin-role-option.active .role-check { border-color: #ed5a32; color: #fff; background: #ed5a32; }
.admin-status-row { display: flex; align-items: center; justify-content: space-between; min-height: 99rpx; margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: #f7f5f2; }
.admin-status-row > view { flex: 1; padding-right: 15rpx; }
.admin-status-row text { display: block; }
.admin-status-row text:first-child { color: #3c3835; font-size: 23rpx; font-weight: 700; }
.admin-status-row text:last-child { margin-top: 4rpx; color: #9a948e; font-size: 18rpx; }
.admin-sheet-actions { display: flex; gap: 14rpx; margin-top: 22rpx; }
.revoke-admin-button, .save-admin-button { flex: 1; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 21rpx; font-size: 25rpx; font-weight: 800; }
.revoke-admin-button { color: #cf5143; background: #fff0ed; }
.save-admin-button { color: #fff; background: linear-gradient(135deg, #ff773e, #f05228); box-shadow: 0 9rpx 21rpx rgba(240,82,40,.18); }
.revoke-admin-button.disabled, .save-admin-button.disabled { opacity: .5; }
@media (max-width: 340px) {
  .member-metrics { grid-template-columns: 1fr; }
  .member-actions { flex-direction: column; }
  .member-actions > view { width: 100%; }
}
