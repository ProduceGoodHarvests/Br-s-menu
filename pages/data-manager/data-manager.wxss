.data-manager-page { padding-top: 0; }

.manager-hero { position: relative; overflow: hidden; margin: 0 -22rpx 20rpx; padding: 34rpx 28rpx 48rpx; color: #fff; background: linear-gradient(145deg, #ff7740, #ed4e27); }
.manager-hero > view:first-child { position: relative; z-index: 1; }
.manager-hero text { display: block; }
.manager-hero text:first-child { font-size: 40rpx; font-weight: 800; }
.manager-hero text:last-child { margin-top: 7rpx; font-size: 21rpx; opacity: .82; }
.hero-decoration { position: absolute; right: -54rpx; top: -90rpx; width: 250rpx; height: 250rpx; border: 2rpx solid rgba(255,255,255,.13); border-radius: 50%; box-shadow: 0 0 0 45rpx rgba(255,255,255,.045); }

.manager-tabs { position: relative; z-index: 2; margin-top: -48rpx; padding: 7rpx; border: 1rpx solid rgba(70,44,30,.04); box-shadow: 0 13rpx 32rpx rgba(59,39,26,.09); }
.manager-tabs .tab { display: flex; align-items: center; justify-content: center; gap: 9rpx; }
.manager-tabs .tab > text:last-child { min-width: 35rpx; height: 35rpx; padding: 0 8rpx; border-radius: 18rpx; background: #f1efec; color: #9b958f; font-size: 18rpx; line-height: 35rpx; }
.manager-tabs .tab.active > text:last-child { color: #e9522a; background: #fff; }

.category-overview { position: relative; overflow: hidden; margin-bottom: 16rpx; padding: 25rpx 23rpx 0; border-radius: 24rpx; color: #fff; background: linear-gradient(145deg, #f4773f, #df4925); box-shadow: 0 12rpx 30rpx rgba(215,69,31,.18); }
.category-overview::after { content: ''; position: absolute; right: -70rpx; top: -100rpx; width: 225rpx; height: 225rpx; border: 2rpx solid rgba(255,255,255,.1); border-radius: 50%; box-shadow: 0 0 0 35rpx rgba(255,255,255,.035); }
.category-overview-head { position: relative; z-index: 1; }
.category-overview-head > view:first-child text:last-child { color: rgba(255,255,255,.72); }
.add-category-button { color: #e7552d; background: #fff; box-shadow: 0 7rpx 17rpx rgba(120,34,10,.16); }
.category-stats { position: relative; z-index: 1; display: flex; margin: 24rpx -23rpx 0; border-top: 1rpx solid rgba(255,255,255,.13); }
.category-stats > view { position: relative; flex: 1; padding: 19rpx 3rpx 21rpx; text-align: center; }
.category-stats > view + view::before { content: ''; position: absolute; left: 0; top: 23rpx; bottom: 23rpx; width: 1rpx; background: rgba(255,255,255,.12); }
.category-stats text { display: block; }
.category-stats text:first-child { font-size: 32rpx; font-weight: 800; }
.category-stats text:last-child { margin-top: 3rpx; color: rgba(255,255,255,.72); font-size: 17rpx; }
.category-toolbar { padding: 17rpx 0 4rpx; }
.category-search { box-shadow: 0 7rpx 24rpx rgba(43,34,27,.035); }
.category-manage-list { display: flex; flex-direction: column; width: 100%; min-width: 0; height: auto; gap: 14rpx; background: transparent; }
.category-card { position: relative; overflow: hidden; width: 100%; min-width: 0; border: 2rpx solid transparent; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 27rpx rgba(43,34,27,.04); animation: tableFadeUp .28s ease both; }
.category-card.disabled { background: #f1efec; box-shadow: none; }
.category-card-main { display: flex; align-items: center; min-height: 130rpx; padding: 20rpx; }
.category-order { width: 68rpx; height: 68rpx; flex: 0 0 68rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 19rpx; color: #e85831; background: #fff0e9; }
.category-order text:first-child { max-width: 62rpx; overflow: hidden; font-size: 25rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.category-order text:last-child { margin-top: -2rpx; font-size: 15rpx; opacity: .75; }
.category-card.disabled .category-order { color: #85807b; background: #dfdcd8; }
.category-info { flex: 1; min-width: 0; margin-left: 16rpx; }
.category-title-row { display: flex; align-items: center; min-width: 0; }
.category-title-row > text { max-width: 300rpx; overflow: hidden; color: #302d2a; font-size: 28rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.category-status { display: flex; align-items: center; flex: 0 0 auto; margin-left: 10rpx; padding: 6rpx 10rpx; border-radius: 999rpx; color: #56835c; background: #edf7ee; font-size: 16rpx; font-weight: 700; }
.category-status view { width: 8rpx; height: 8rpx; margin-right: 6rpx; border-radius: 50%; background: #63a76c; }
.category-status.disabled { color: #88827c; background: #dfdcd8; }
.category-status.disabled view { background: #98928c; }
.category-dish-meta { display: flex; align-items: center; margin-top: 9rpx; color: #99938d; font-size: 19rpx; }
.category-dish-meta text:nth-child(2) { margin: 0 7rpx; color: #d0cbc6; }
.category-edit-entry { width: 52rpx; height: 52rpx; flex: 0 0 52rpx; border-radius: 50%; color: #a29c96; background: #f5f3f0; font-size: 39rpx; line-height: 48rpx; text-align: center; }
.category-card-actions { display: flex; border-top: 1rpx solid #f0ede9; }
.category-card-actions > view { flex: 1; height: 62rpx; color: #66605a; font-size: 20rpx; line-height: 62rpx; text-align: center; }
.category-card-actions > view + view { border-left: 1rpx solid #f0ede9; }
.category-card-actions .delete-action { color: #d45a4b; }
.category-card-actions .action-disabled { color: #c4bfba; }
.category-skeleton-list { display: flex; flex-direction: column; gap: 14rpx; }
.category-skeleton { display: flex; align-items: center; height: 132rpx; padding: 21rpx; border-radius: 22rpx; background: #fff; }
.category-skeleton-icon { width: 68rpx; height: 68rpx; flex: 0 0 68rpx; border-radius: 19rpx; }
.category-skeleton-main { flex: 1; margin-left: 17rpx; }
.category-skeleton-main view { width: 58%; height: 24rpx; border-radius: 12rpx; }
.category-skeleton-main view:last-child { width: 76%; height: 17rpx; margin-top: 17rpx; }
.sort-help { display: flex; justify-content: space-between; margin-top: 10rpx; color: #aaa49e; font-size: 17rpx; }
.category-enable-row { margin-top: 7rpx; }
.compact-empty { margin-top: 20rpx; }
.empty-icon { font-size: 70rpx; color: #ef6b40; }

.table-overview { overflow: hidden; margin-bottom: 16rpx; padding: 25rpx 23rpx 0; border-radius: 24rpx; background: linear-gradient(145deg, #33302d, #48423d); color: #fff; box-shadow: 0 12rpx 30rpx rgba(42,36,32,.14); }
.overview-head { display: flex; align-items: center; justify-content: space-between; }
.overview-head > view:first-child text { display: block; }
.overview-head > view:first-child text:first-child { font-size: 29rpx; font-weight: 800; }
.overview-head > view:first-child text:last-child { margin-top: 5rpx; color: #bdb7b1; font-size: 19rpx; }
.add-table-button { display: flex; align-items: center; height: 59rpx; padding: 0 17rpx; border-radius: 18rpx; background: linear-gradient(135deg, #ff7841, #ed4e27); box-shadow: 0 7rpx 17rpx rgba(228,72,32,.25); font-size: 22rpx; font-weight: 700; }
.add-table-button:active { transform: scale(.97); }
.add-table-button text:first-child { margin-right: 5rpx; font-size: 31rpx; font-weight: 400; }
.overview-stats { display: flex; margin: 24rpx -23rpx 0; border-top: 1rpx solid rgba(255,255,255,.08); }
.overview-stats > view { position: relative; flex: 1; padding: 19rpx 4rpx 21rpx; text-align: center; }
.overview-stats > view + view::before { content: ''; position: absolute; left: 0; top: 23rpx; bottom: 23rpx; width: 1rpx; background: rgba(255,255,255,.08); }
.overview-stats text { display: block; }
.overview-stats text:first-child { font-size: 32rpx; font-weight: 800; }
.overview-stats text:last-child { margin-top: 3rpx; color: #aaa49e; font-size: 17rpx; }
.overview-stats .idle-text { color: #86d495; }
.overview-stats .occupied-text { color: #ff9a6d; }
.overview-stats .disabled-text { color: #aaa6a2; }

.table-toolbar { margin-bottom: 18rpx; padding: 17rpx 0 2rpx; }
.table-search { display: flex; align-items: center; height: 76rpx; padding: 0 19rpx; border-radius: 19rpx; background: #fff; box-shadow: 0 7rpx 24rpx rgba(43,34,27,.035); }
.table-search > text:first-child { color: #6f6a65; font-size: 35rpx; transform: rotate(-15deg); }
.table-search input { flex: 1; height: 100%; margin-left: 11rpx; font-size: 24rpx; }
.table-search .search-clear { width: 38rpx; height: 38rpx; border-radius: 50%; background: #efedea; color: #96908a; line-height: 36rpx; text-align: center; transform: none; }
.filter-scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.filter-list { display: inline-flex; gap: 10rpx; padding-right: 22rpx; }
.filter-chip { display: inline-flex; align-items: center; justify-content: center; min-width: 104rpx; height: 57rpx; padding: 0 20rpx; border: 1rpx solid #e7e3df; border-radius: 999rpx; background: #fff; color: #77716b; font-size: 21rpx; }
.filter-chip.active { border-color: #f06a3f; background: #fff1ea; color: #e9532c; font-weight: 700; }
.area-scroll { margin-top: 10rpx; }
.area-chip { min-width: auto; height: 50rpx; background: transparent; }

.table-grid, .table-skeleton-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; }
.table-card, .table-skeleton { position: relative; overflow: hidden; min-height: 285rpx; padding: 19rpx; border: 2rpx solid transparent; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 27rpx rgba(43,34,27,.04); animation: tableFadeUp .28s ease both; }
.table-card.occupied { border-color: rgba(239,94,48,.18); background: linear-gradient(160deg, #fff, #fff9f6); }
.table-card.disabled { opacity: .78; background: #f0eeeb; box-shadow: none; }
.table-card-top { display: flex; align-items: center; justify-content: space-between; }
.table-symbol { width: 53rpx; height: 53rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #54845b; background: #edf7ee; font-size: 27rpx; }
.table-symbol.occupied { color: #ed572f; background: #fff0e9; }
.table-symbol.disabled { color: #918b85; background: #dfdcd8; }
.table-status { display: flex; align-items: center; padding: 7rpx 10rpx; border-radius: 999rpx; color: #57855e; background: #edf7ee; font-size: 17rpx; font-weight: 700; }
.table-status view { width: 9rpx; height: 9rpx; margin-right: 6rpx; border-radius: 50%; background: #65aa70; box-shadow: 0 0 0 4rpx rgba(101,170,112,.12); }
.table-status.occupied { color: #e7562f; background: #fff0e9; }
.table-status.occupied view { background: #ef6038; box-shadow: 0 0 0 4rpx rgba(239,96,56,.12); }
.table-status.disabled { color: #88827c; background: #dfdcd8; }
.table-status.disabled view { background: #9c9690; box-shadow: none; }
.table-number { display: block; margin-top: 19rpx; color: #302d2a; font-size: 38rpx; font-weight: 900; letter-spacing: 1rpx; }
.table-meta { display: flex; align-items: center; min-height: 49rpx; margin-top: 4rpx; color: #9d9791; font-size: 17rpx; line-height: 1.4; }
.table-meta text:nth-child(2) { margin: 0 6rpx; color: #d2cdc8; }
.occupied-order { display: flex; justify-content: space-between; margin-top: 4rpx; padding: 9rpx 10rpx; border-radius: 10rpx; color: #b45438; background: #fff0e9; font-size: 16rpx; }
.table-card-actions { display: flex; margin: 16rpx -19rpx -19rpx; border-top: 1rpx solid #f0ede9; }
.table-card-actions > view { flex: 1; height: 62rpx; color: #66605a; font-size: 19rpx; line-height: 62rpx; text-align: center; }
.table-card-actions > view + view { border-left: 1rpx solid #f0ede9; }
.table-card-actions .delete-action { color: #d45a4b; }
.table-card-actions .action-disabled { color: #c4bfba; }
.card-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,.78); backdrop-filter: blur(3px); }
.loading-spinner { width: 43rpx; height: 43rpx; border: 4rpx solid #f2d3c7; border-top-color: #ed572f; border-radius: 50%; animation: spin .75s linear infinite; }
.table-skeleton { min-height: 270rpx; }
.skeleton-table-no { width: 55%; height: 34rpx; margin-top: 53rpx; border-radius: 10rpx; }
.skeleton-table-line { width: 78%; height: 18rpx; margin-top: 18rpx; border-radius: 9rpx; }
.skeleton-table-action { width: 100%; height: 52rpx; margin-top: 48rpx; border-radius: 12rpx; }
.table-empty { margin-top: 4rpx; }
.empty-action { display: inline-flex; align-items: center; justify-content: center; height: 62rpx; margin-top: 24rpx; padding: 0 26rpx; border: 1rpx solid #ded9d4; border-radius: 17rpx; color: #6f6963; font-size: 22rpx; }
.primary-empty-action { border: 0; color: #fff; background: linear-gradient(135deg, #ff773e, #f05228); }

.table-sheet-mask { animation: maskFadeIn .2s ease both; }
.table-form-sheet { padding-top: 16rpx; animation: sheetUp .28s cubic-bezier(.2,.8,.2,1) both; }
.table-form-sheet .sheet-handle { margin-bottom: 22rpx; }
.table-sheet-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 29rpx; }
.table-sheet-head > view:first-child text { display: block; }
.table-sheet-head > view:first-child text:first-child { color: #302d2a; font-size: 35rpx; font-weight: 800; }
.table-sheet-head > view:first-child text:last-child { margin-top: 7rpx; color: #9d9791; font-size: 20rpx; }
.table-sheet-head > view:last-child { width: 53rpx; height: 53rpx; border-radius: 50%; background: #f2f0ed; color: #8d8781; font-size: 35rpx; line-height: 49rpx; text-align: center; }
.table-form-field { margin-bottom: 24rpx; }
.field-label { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.field-label text:first-child { color: #4a4541; font-size: 23rpx; font-weight: 700; }
.field-label text:last-child { color: #aaa49e; font-size: 18rpx; }
.field-input { display: flex; align-items: center; height: 82rpx; padding: 0 18rpx; border: 2rpx solid #ebe7e3; border-radius: 18rpx; background: #faf9f7; }
.field-input:focus-within { border-color: #ef6a40; background: #fff; }
.field-input > text { width: 42rpx; color: #ed633b; font-size: 28rpx; }
.field-input input { flex: 1; height: 100%; color: #34312e; font-size: 26rpx; }
.field-input.readonly { background: #efedea; }
.field-input.readonly input { color: #8e8882; }
.area-suggestions { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 12rpx; }
.area-suggestions view { padding: 8rpx 15rpx; border-radius: 999rpx; background: #f2f0ed; color: #79736d; font-size: 19rpx; }
.area-suggestions view.active { color: #e7552e; background: #fff0e9; }
.table-enable-row { display: flex; align-items: center; justify-content: space-between; min-height: 101rpx; margin: 3rpx 0 25rpx; padding: 17rpx 19rpx; border-radius: 18rpx; background: #f7f5f2; }
.table-enable-row > view { flex: 1; padding-right: 18rpx; }
.table-enable-row text { display: block; }
.table-enable-row text:first-child { color: #423e3a; font-size: 23rpx; font-weight: 700; }
.table-enable-row text:last-child { margin-top: 5rpx; color: #99938d; font-size: 18rpx; line-height: 1.45; }
.occupied-tip { display: flex; align-items: center; margin: 3rpx 0 25rpx; padding: 17rpx; border-radius: 17rpx; color: #a5543a; background: #fff2eb; }
.occupied-tip > text { width: 39rpx; height: 39rpx; border-radius: 50%; color: #fff; background: #ed633b; font-weight: 800; line-height: 39rpx; text-align: center; }
.occupied-tip > view { flex: 1; margin-left: 13rpx; }
.occupied-tip > view text { display: block; }
.occupied-tip > view text:first-child { font-size: 22rpx; font-weight: 700; }
.occupied-tip > view text:last-child { margin-top: 3rpx; font-size: 18rpx; opacity: .8; }
.table-save-button { width: 100%; height: 84rpx; border-radius: 21rpx; font-size: 27rpx; line-height: 84rpx; }

@keyframes tableFadeUp { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes maskFadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheetUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
