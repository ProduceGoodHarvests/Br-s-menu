<view class="page order-detail-page {{themeClass}}">
  <view class="detail-loading" wx:if="{{loading}}"><view class="detail-loading-card" wx:for="{{[1, 2]}}" wx:key="*this"><view class="skeleton-line wide shimmer"></view><view class="skeleton-line shimmer"></view><view class="skeleton-line short shimmer"></view></view></view>
  <view class="detail-error" wx:elif="{{error}}"><view class="detail-error-icon">!</view><view class="detail-error-title">订单详情暂时无法加载</view><view class="detail-error-desc">{{error}}</view><view class="detail-retry" bindtap="retryLoad">重新加载</view></view>
  <block wx:elif="{{order}}">
    <view class="status-card {{order.statusClass}}">
      <view class="status-top"><view><text>{{order.statusText}}</text><text>{{order.orderStatus === 'ready' ? '餐品已准备好，请尽快取餐' : (order.isRejected ? '已扣虚拟金币将自动退回账户' : '订单状态会自动更新')}}</text></view><view class="status-icon">{{order.orderStatus === 'completed' ? '✓' : (order.orderStatus === 'cancelled' || order.isRejected ? '×' : '◷')}}</view></view>
      <view class="status-progress" wx:if="{{order.progress > 0 && order.orderStatus !== 'completed'}}"><view class="status-progress-fill" style="width: {{(order.progress - 1) * 25}}%"></view><view wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="status-step {{order.progress >= item ? 'active' : ''}}"><text>{{order.progress > item ? '✓' : item}}</text></view></view>
      <view class="status-progress-labels" wx:if="{{order.progress > 0 && order.orderStatus !== 'completed'}}"><text>已支付</text><text>已接单</text><text>制作中</text><text>待取餐</text><text>已完成</text></view>
    </view>

    <view class="detail-card order-info-card"><view class="section-title">订单信息</view><view class="info-row"><text>订单编号</text><text selectable="true">{{order.orderNo}}</text></view><view class="info-row"><text>下单时间</text><text>{{order.createTimeText}}</text></view><view class="info-row" wx:if="{{order.updateTimeText}}"><text>更新时间</text><text>{{order.updateTimeText}}</text></view><view class="info-row"><text>用餐方式</text><text>{{order.typeText}}{{order.tableNo ? ' · ' + order.tableNo + '桌' : ''}}</text></view></view>

    <view class="detail-card"><view class="section-title">菜品清单 <text>共 {{order.goodsCount}} 件</text></view><view class="goods-line" wx:for="{{order.goodsList}}" wx:key="goodsId"><view class="goods-main"><text>{{item.name}}</text><text wx:if="{{item.specs.length}}"><text wx:for="{{item.specs}}" wx:key="name" wx:for-item="spec">{{spec.value}} </text></text></view><text>×{{item.quantity}}</text><text>¥{{item.subtotal}}</text></view><view class="detail-discount" wx:if="{{order.discountAmount > 0}}"><text>{{order.memberDiscountText}}</text><text>已省 ¥{{order.discountAmountText}}</text></view><view class="sum-row"><text>会员实付</text><text>¥{{order.totalPriceText}}</text></view></view>

    <view class="detail-card"><view class="section-title">支付信息</view><view class="info-row" wx:if="{{order.hasCoinPayment}}"><text>虚拟金币支付</text><text class="coin-value">{{order.coinUsedText}} 金币</text></view><view class="info-row"><text>{{order.isCoinOnly ? '支付方式' : '微信实付'}}</text><text class="pay-value">{{order.isCoinOnly ? '虚拟金币支付' : '¥' + order.payPriceText}}</text></view><view class="info-row" wx:if="{{order.scoreEarned > 0}}"><text>本单累计积分</text><text class="score-value">+{{order.scoreEarned}} 分</text></view></view>

    <view class="detail-card remark-card" wx:if="{{order.remark}}"><view class="section-title">口味备注</view><view class="remark-text">{{order.remark}}</view></view>
    <view class="detail-card reject-reason-card" wx:if="{{order.isRejected}}"><view class="section-title">拒绝出餐说明</view><view class="reject-reason-text">{{order.rejectReason}}</view></view>
    <view class="detail-safe-tip">订单状态每 8 秒自动更新，也可下拉页面手动刷新</view>
    <view class="detail-footer" wx:if="{{order.canReorder}}"><view class="detail-footer-copy"><text>想再吃一次？</text><text>相同菜品会加入餐篮，价格以结算时为准</text></view><view class="detail-reorder" bindtap="reorder">再来一单</view></view>
  </block>
</view>
