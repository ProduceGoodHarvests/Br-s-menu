.order-detail-page { min-height: 100vh; padding: 22rpx 22rpx 170rpx; background: #f6f5f3; }
.detail-loading { padding-top: 10rpx; }.detail-loading-card { min-height: 190rpx; margin-bottom: 20rpx; padding: 32rpx; border-radius: 25rpx; background: #fff; }
.detail-error { min-height: 650rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx; text-align: center; }.detail-error-icon { width: 96rpx; height: 96rpx; border-radius: 34rpx; color: #d06647; background: #fff0eb; font-size: 52rpx; font-weight: 800; line-height: 96rpx; }.detail-error-title { margin-top: 28rpx; color: #39332e; font-size: 32rpx; font-weight: 800; }.detail-error-desc { margin-top: 13rpx; color: #98908a; font-size: 23rpx; line-height: 1.6; }.detail-retry { min-width: 226rpx; height: 76rpx; margin-top: 33rpx; border-radius: 22rpx; color: #fff; background: linear-gradient(135deg, #ff7740, #ee4d27); box-shadow: 0 10rpx 22rpx rgba(235,76,37,.22); font-size: 26rpx; font-weight: 800; line-height: 76rpx; }
.status-card, .detail-card { margin-bottom: 20rpx; padding: 26rpx; border-radius: 25rpx; background: #fff; box-shadow: 0 9rpx 27rpx rgba(52,39,28,.04); }.status-card { color: #fff; background: linear-gradient(135deg, #f67742, #eb4e29); box-shadow: 0 16rpx 32rpx rgba(226,77,38,.21); }.status-card.completed { background: linear-gradient(135deg, #56b694, #2e9270); }.status-card.cancelled { color: #756e68; background: linear-gradient(135deg, #f1eeea, #e9e4df); box-shadow: none; }.status-top { display: flex; align-items: center; justify-content: space-between; }.status-top > view:first-child text { display: block; }.status-top > view:first-child text:first-child { font-size: 35rpx; font-weight: 900; }.status-top > view:first-child text:last-child { margin-top: 8rpx; font-size: 21rpx; opacity: .84; }.status-icon { width: 72rpx; height: 72rpx; border: 2rpx solid rgba(255,255,255,.27); border-radius: 23rpx; background: rgba(255,255,255,.15); font-size: 40rpx; font-weight: 700; line-height: 67rpx; text-align: center; }.cancelled .status-icon { border-color: #d4ccc5; background: #fff; }
.status-progress { position: relative; display: flex; justify-content: space-between; margin-top: 36rpx; }.status-progress::before, .status-progress-fill { position: absolute; top: 17rpx; left: 18rpx; right: 18rpx; height: 4rpx; border-radius: 4rpx; content: ''; }.status-progress::before { background: rgba(255,255,255,.3); }.status-progress-fill { right: auto; background: #fff; transition: width .25s ease; }.status-step { position: relative; z-index: 1; width: 38rpx; height: 38rpx; border: 3rpx solid rgba(255,255,255,.55); border-radius: 50%; color: rgba(255,255,255,.72); background: #e85c35; font-size: 19rpx; font-weight: 800; line-height: 32rpx; text-align: center; }.status-step.active { border-color: #fff; color: #e7552d; background: #fff; }.status-progress-labels { display: flex; justify-content: space-between; margin-top: 10rpx; color: rgba(255,255,255,.86); font-size: 16rpx; }.status-progress-labels text { width: 20%; text-align: center; }.status-progress-labels text:first-child { text-align: left; }.status-progress-labels text:last-child { text-align: right; }
.section-title { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 19rpx; color: #39332e; font-size: 29rpx; font-weight: 800; }.section-title text { color: #a39b93; font-size: 19rpx; font-weight: 400; }.info-row { display: flex; align-items: center; justify-content: space-between; min-height: 60rpx; color: #958c84; font-size: 22rpx; }.info-row + .info-row { border-top: 1rpx solid #f0ece8; }.info-row text:last-child { max-width: 64%; color: #514a44; font-weight: 600; text-align: right; }.coin-value { color: #b1780d !important; }.pay-value { color: #e2562d !important; font-size: 25rpx !important; font-weight: 800 !important; }
.goods-line { display: grid; grid-template-columns: minmax(0, 1fr) 58rpx 106rpx; gap: 8rpx; min-height: 73rpx; padding: 13rpx 0; border-top: 1rpx solid #f0ece8; color: #867d76; font-size: 21rpx; align-items: center; }.goods-line > text:nth-child(2), .goods-line > text:last-child { text-align: right; }.goods-line > text:last-child { color: #514a44; font-weight: 800; }.goods-main { min-width: 0; }.goods-main > text:first-child { display: block; overflow: hidden; padding-left: 10rpx; border-left: 5rpx solid #ef6339; color: #302a25; font-size: 27rpx; font-weight: 800; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }.goods-main > text:last-child { display: block; overflow: hidden; margin-top: 5rpx; color: #a09992; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.sum-row { display: flex; align-items: center; justify-content: space-between; padding-top: 18rpx; border-top: 1rpx dashed #e8e1da; color: #756c64; font-size: 22rpx; }.sum-row text:last-child { color: #e2572f; font-size: 28rpx; font-weight: 900; }.remark-text { padding: 16rpx; border-radius: 16rpx; color: #8b644c; background: #fff5e9; font-size: 22rpx; line-height: 1.65; }.detail-safe-tip { margin: 26rpx 0; color: #a19992; font-size: 19rpx; text-align: center; }.detail-footer { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; padding: 17rpx 22rpx calc(17rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); box-shadow: 0 -8rpx 25rpx rgba(43,32,24,.08); }.detail-footer-copy { min-width: 0; }.detail-footer-copy text { display: block; }.detail-footer-copy text:first-child { color: #443d37; font-size: 25rpx; font-weight: 800; }.detail-footer-copy text:last-child { overflow: hidden; max-width: 370rpx; margin-top: 4rpx; color: #a39b94; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.detail-reorder { flex: 0 0 auto; min-width: 170rpx; height: 74rpx; border-radius: 21rpx; color: #fff; background: linear-gradient(135deg, #ff7740, #ee4d27); box-shadow: 0 9rpx 19rpx rgba(235,76,37,.21); font-size: 25rpx; font-weight: 800; line-height: 74rpx; text-align: center; }
.reject-reason-card { border: 1rpx solid #f1d8d2; }.reject-reason-text { padding: 16rpx; border-radius: 16rpx; color: #925b50; background: #fff2ef; font-size: 22rpx; line-height: 1.65; }
.detail-discount { display: flex; align-items: center; justify-content: space-between; margin: 9rpx 0 12rpx; padding: 10rpx 12rpx; border-radius: 12rpx; color: #88682c; background: #fff8e6; font-size: 20rpx; }
.detail-discount text:last-child { color: #bf7e12; font-weight: 800; }
.score-value { color: #b27a10 !important; font-size: 24rpx !important; font-weight: 800 !important; }
.coin-value { display: block; overflow: hidden; max-width: 68%; text-overflow: ellipsis; white-space: nowrap; }
